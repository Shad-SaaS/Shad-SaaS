generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  role           String    @default("CUSTOMER") // CUSTOMER, ADMIN, SUPPORT
  status         String    @default("ACTIVE")   // ACTIVE, SUSPENDED
  walletBalance  Float     @default(0.0)
  vipTierId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions           Session[]
  orders             Order[]
  walletTransactions WalletTransaction[]
  depositRequests    DepositRequest[]
  supportTickets     SupportTicket[]
  couponRedemptions  CouponRedemption[]
  auditLogs          AuditLog[]
  vipTier            VipTier?            @relation(fields: [vipTierId], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  columns     Int       @default(3) // 1 to 4 columns
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id                String             @id @default(cuid())
  categoryId        String
  name              String
  slug              String             @unique
  shortDesc         String?
  description       String?
  image             String?
  minPrice          Float              @default(0.0)
  costPrice         Float              @default(0.0)
  executionTime     String?            @default("5 - 15 دقيقة")
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  providerId        String?            // Link to ApiProvider
  providerProductId String?            // Product ID at the external provider
  providerType      String             @default("MANUAL") // MANUAL, API, AUTO_CODE
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  provider    ApiProvider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  formFields  ProductFormField[]
  orders      Order[]
  autoCodes   AutoCode[]
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String
  price         Float
  originalPrice Float?
  costPrice     Float    @default(0.0)
  stockQuantity Int      @default(-1) // -1 for unlimited
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model ProductFormField {
  id          String   @id @default(cuid())
  productId   String
  fieldName   String
  label       String
  fieldType   String   @default("text") // text, number, url, email, select
  placeholder String?
  isRequired  Boolean  @default(true)
  optionsJson String?
  sortOrder   Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id             String    @id @default(cuid())
  orderNumber    String    @unique
  userId         String
  productId      String
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED, PARTIAL
  totalAmount    Float
  discountAmount Float     @default(0.0)
  couponCode     String?
  customerInputs String    // JSON string containing form values
  deliveryNotes  String?   // Codes or activation details given to customer
  internalNotes  String?
  refundAmount   Float     @default(0.0)
  externalOrderId String?  // ID from provider (Mersal/Alkasr/etc)
  providerResponse String? // Raw response from provider API
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  product       Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  variantId   String
  variantName String
  quantity    Int    @default(1)
  unitPrice   Float
  totalPrice  Float

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model OrderStatusHistory {
  id              String   @id @default(cuid())
  orderId         String
  fromStatus      String?
  toStatus        String
  note            String?
  changedByUserId String?
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id                String   @id @default(cuid())
  code              String   @unique // SYRIATEL_CASH, MTN_CASH, SHAM_CASH, CRYPTO_USDT, AL_HARAM
  name              String
  accountNumber     String
  accountHolderName String
  instructions      String
  minDeposit        Float    @default(1000.0)
  isActive          Boolean  @default(true)
  icon              String?
  qrCodeUrl         String?
  autoVerification  Boolean  @default(false) // If true, can verify through Sam API
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DepositRequest {
  id                String    @id @default(cuid())
  depositNumber     String    @unique
  userId            String
  paymentMethodCode String
  amount            Float
  referenceNumber   String
  receiptImageUrl   String?
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason   String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  isAutoVerified    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  type          String   // DEPOSIT, ORDER_PAYMENT, REFUND, PARTIAL_REFUND, ADMIN_ADJUSTMENT
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceType String   // DEPOSIT_REQUEST, ORDER, MANUAL
  referenceId   String?
  description   String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    // PERCENTAGE, FIXED
  discountValue  Float
  minOrderAmount Float     @default(0.0)
  maxDiscount    Float?
  usageLimit     Int       @default(100)
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  userId          String
  orderId         String
  discountApplied Float
  createdAt       DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model SupportTicket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  userId       String
  subject      String
  category     String   @default("GENERAL") // GENERAL, ORDER, DEPOSIT, TECHNICAL
  priority     String   @default("MEDIUM")  // LOW, MEDIUM, HIGH
  status       String   @default("OPEN")    // OPEN, ANSWERED, CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages SupportMessage[]
}

model SupportMessage {
  id            String   @id @default(cuid())
  ticketId      String
  senderId      String
  senderRole    String   // CUSTOMER, ADMIN, SUPPORT
  message       String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ==========================================
// NEW: External Providers & API Integrations
// ==========================================

model ApiProvider {
  id           String    @id @default(cuid())
  name         String    // e.g. "Alkasr VIP", "Mersal Card", "Sam API Payments"
  code         String    @unique // alkasr, mersal, alhallak, yazancard, tartousi, alzaeem, sam_api
  template     String    @default("client_api_v1") // client_api_v1, sam_api, modc_agent, custom
  baseUrl      String
  apiToken     String
  isActive     Boolean   @default(true)
  balance      Float     @default(0.0)
  currency     String    @default("USD")
  lastSyncAt   DateTime?
  configJson   String?   // JSON settings for paths or custom headers
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products Product[]
}

model AutoCode {
  id         String    @id @default(cuid())
  productId  String
  code       String
  note       String?
  isUsed     Boolean   @default(false)
  usedByOrderId String?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model VipTier {
  id           String   @id @default(cuid())
  name         String
  minSpent     Float    @default(0.0)
  discountRate Float    @default(0.0) // Percentage discount e.g. 5%
  badgeColor   String   @default("blue")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  users User[]
}

model OrderMessageTemplate {
  id        String   @id @default(cuid())
  event     String   @unique // ORDER_CREATED, ORDER_ACCEPTED, ORDER_REJECTED, DEPOSIT_CREATED, DEPOSIT_APPROVED, DEPOSIT_REJECTED
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String
  targetUrl  String?
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model StoreSetting {
  id          String   @id // e.g. store_name, store_logo, currency, announcement, contact_whatsapp
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
