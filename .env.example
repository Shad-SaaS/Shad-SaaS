# Database connection (Neon PostgreSQL on Vercel, or local SQLite/MySQL on VPS)
DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Auth & Encryption Secrets
JWT_SECRET=generate-a-strong-random-jwt-secret-string-min-32-chars
ENCRYPTION_KEY=generate-a-strong-aes-256-encryption-key
SESSION_COOKIE_NAME=shad_auth_token

# Store Information
NEXT_PUBLIC_APP_NAME=Shad Store
NEXT_PUBLIC_APP_URL=https://shad-store.com
NEXT_PUBLIC_DEFAULT_CURRENCY=ل.س

# Cron Security Token
CRON_SECRET=generate-a-strong-secret-for-order-sync-cron
